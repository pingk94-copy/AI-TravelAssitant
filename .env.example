# Backend
APP_NAME=ai-travel-assistant-api
APP_VERSION=0.1.0
API_PREFIX=/api
DATABASE_URL=sqlite:///./travel_assistant.db
JWT_SECRET_KEY=change-this-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Large language model.
# Copy this file to backend/.env, then fill in your key.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# Optional map data provider.
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3
EXTERNAL_API_TIMEOUT_SECONDS=5
